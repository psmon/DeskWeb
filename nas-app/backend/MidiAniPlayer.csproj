<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Native AOT: single self-contained binary, no reflection-based JSON -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>midi-ani-player</AssemblyName>
    <RootNamespace>MidiAniPlayer</RootNamespace>

    <!-- Trim-friendly: fail the build if anything is AOT-incompatible -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SMBLibrary" Version="1.5.7.1" />
  </ItemGroup>

  <!-- SMBLibrary uses reflection internally; keep it whole so AOT trimming
       doesn't remove members needed at runtime (IL2104). -->
  <ItemGroup>
    <TrimmerRootAssembly Include="SMBLibrary" />
  </ItemGroup>

</Project>

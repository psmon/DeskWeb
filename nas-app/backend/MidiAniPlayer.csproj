<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Native AOT: single self-contained binary, no reflection-based JSON -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>midi-ani-player</AssemblyName>
    <RootNamespace>MidiAniPlayer</RootNamespace>

    <!-- Trim-friendly: fail the build if anything is AOT-incompatible -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SMBLibrary" Version="1.5.7.1" />
    <!-- Embedded playlist DB (bitmidi + local scan) with FTS5 full-text search.
         bundle_e_sqlite3 ships the native lib (FTS5 compiled in) for linux-x64/arm64;
         Microsoft.Data.Sqlite is used via raw ADO SQL only (no reflection) → AOT-safe. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="9.0.4" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <!-- These use reflection/native interop internally; keep them whole so AOT
       trimming doesn't remove members needed at runtime (IL2104). -->
  <ItemGroup>
    <TrimmerRootAssembly Include="SMBLibrary" />
    <TrimmerRootAssembly Include="Microsoft.Data.Sqlite" />
    <TrimmerRootAssembly Include="SQLitePCLRaw.core" />
    <TrimmerRootAssembly Include="SQLitePCLRaw.provider.e_sqlite3" />
    <TrimmerRootAssembly Include="SQLitePCLRaw.batteries_v2" />
  </ItemGroup>

</Project>

# .gitignore for multi-project structure

# Build output (all projects)
**/compiled
compiled/

# Dependencies (all projects)
**/node_modules
node_modules/

# Qooxdoo packages
**/qx_packages
.package-cache.json

# Environment
.env
**/.env

# Python virtual environment
.venv/
**/.venv

# Local scratch (may contain device serial/MAC/personal info — never publish)
tmp/

# IDE
.idea/

# secrets (never commit)
.secret/
